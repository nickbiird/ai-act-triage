{
  "name": "ai-act-triage",
  "version": "0.1.0",
  "private": true,
  "description": "EU AI Act risk-tier triage with an auditable agent pipeline: hybrid RAG over the Act, proposer/critic arbitration, durable human approval, and evals in CI.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:embed": "tsx scripts/embed.ts",
    "evals": "tsx evals/run.ts",
    "evals:retrieval": "tsx evals/retrieval.ts",
    "evals:probes": "tsx evals/probes.ts",
    "evals:record": "tsx evals/run.ts --record",
    "capture:demo": "tsx scripts/capture-demo.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.4.1",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.3.7",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.2",
    "mcp-handler": "^1.1.0",
    "minisearch": "^7.2.0",
    "next": "^15.5.6",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
