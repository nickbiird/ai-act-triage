# --- Reasoning provider (the gate / query-planner / proposer / critic) ---
# LLM_PROVIDER selects the backend: "anthropic" (default) or "google".
LLM_PROVIDER=anthropic
# Anthropic (default reasoning backend). Required for live assessments unless
# LLM_PROVIDER=google. The recorded demo needs NO key.
ANTHROPIC_API_KEY=

# --- Embeddings (dense retrieval leg only) ---
# Google AI Studio key (free tier / student credits work). Anthropic has no
# embeddings API, so the dense retrieval leg needs this REGARDLESS of
# LLM_PROVIDER. Without it, retrieval degrades to BM25-only (the app says so).
# Also the reasoning key when LLM_PROVIDER=google.
GOOGLE_API_KEY=

# --- Optional: durable HITL + multi-turn persistence ---
# Postgres connection string (Neon / Supabase free tier works).
# When unset, the app falls back to in-memory checkpointing: assessments still
# run, but a pending approval does NOT survive a restart or a fresh serverless
# invocation. The UI prints which mode is active. This degradation is the exact
# gap this project criticises in ephemeral-HITL platforms, so it is surfaced,
# never hidden.
DATABASE_URL=

# --- Model tiering (env-swappable on purpose: model strings are one variable) ---
# Fast tier: input gate + query planning. Deep tier: proposer + adversarial critic.
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_DEEP=claude-sonnet-4-6
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_DEEP=gemini-2.5-pro
GEMINI_EMBED_MODEL=gemini-embedding-001

# --- Demo hardening ---
# Per-IP daily assessment cap for the public deployment (0 = unlimited).
RATE_LIMIT_PER_DAY=10
